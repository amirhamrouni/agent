[application]
config/name="Hayat Tounes 3D"
config/version="0.53.35"
config/icon="res://assets/branding/hayat_tounes_icon.svg"
run/main_scene="res://main_production.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameState="*res://autoload/GameState.gd"
SaveService="*res://autoload/SaveService.gd"
RuntimeDiagnostics="*res://autoload/RuntimeDiagnostics.gd"
SettingsService="*res://autoload/SettingsService.gd"
SessionGuard="*res://autoload/SessionGuard.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]
phone_jobs={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":80,"unicode":112)]
}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventKey,"physical_keycode":16)]}

[physics]
common/enable_pause_aware_picking=true
3d/default_gravity=18.0
